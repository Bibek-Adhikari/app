# Stunner App - Environment Variables

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_FUNCTIONS_URL=your_supabase_functions_url

# LiveKit Configuration (for voice/video calls)
VITE_LIVEKIT_URL=your_livekit_url
VITE_LIVEKIT_API_KEY=your_livekit_api_key

# Optional: Gemini API (if not using Supabase Edge Functions)
VITE_GEMINI_API_KEY=your_gemini_api_key
